{
  "manifest_version": 3,
  "name": "Photopea Full Width",
  "description": "Reclaims Photopea's reserved ad column, hides its home-screen logo, and removes its source-code warning.",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://photopea.com/*",
        "https://www.photopea.com/*"
      ],
      "css": [
        "photopea.css"
      ],
      "js": [
        "photopea.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
