{
  "manifest_version": 3,
  "name": "Photopea Full Width",
  "description": "Removes Photopea's ad sidebar, expands the editor to full width, hides its Home screen logo, and removes one related warning.",
  "version": "1.0.1",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://photopea.com/*",
        "https://www.photopea.com/*"
      ],
      "css": [
        "photopea.css"
      ],
      "js": [
        "photopea.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
