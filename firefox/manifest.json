{
  "manifest_version": 3,
  "name": "Photopea Full Width",
  "description": "Reclaims Photopea's reserved ad column, hides its home-screen logo, and removes its source-code warning.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "photopea-fullwidth@local.afonsojramos",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://photopea.com/*", "https://www.photopea.com/*"],
      "css": ["photopea.css"],
      "css_origin": "user",
      "js": ["photopea.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
