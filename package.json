{
  "name": "photopea-fullwidth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "capture:store": "pnpm run build && node scripts/capture-store-assets.mjs",
    "check:photopea": "pnpm run build && node scripts/check-photopea.mjs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "package": "pnpm run build && node scripts/package.mjs",
    "verify": "pnpm run fmt:check && pnpm run lint && pnpm run build && node scripts/verify.mjs"
  },
  "devDependencies": {
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "playwright": "1.62.1"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.4"
}
